package sample.globalobserver;
import java.io.PrintStream;
import java.util.*;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.item.*;
import net.minecraft.world.flag.FeatureFlags;
import HOST.fml.ModList;
import HOST.fml.common.Mod;
import HOST.bus.api.EventPriority;
import HOST.event.server.ServerStartedEvent;
@Mod("globalobserver")
public final class Observer {
 private final PrintStream original=System.out;
 private final Map<String,Integer> calls=new HashMap<>();
 private final String variant=System.getenv("DF4C3_VARIANT");
 private boolean queried,early;private String phase="LOADING";
 public Observer(){
  System.setOut(new PrintStream(original){@Override public void println(String text){original.println(text);
   if(text.equals("[DF4C3] BEFORE TAB"))early();
   if(text.startsWith("[DF4C3] HANDLER ")||text.startsWith("[DF4C3] SUPPLIER ")||text.startsWith("[DF4C3] CALLBACK ")){
    calls.merge(text,1,Integer::sum);var frames=StackWalker.getInstance().walk(s->s.toList());boolean registering=frames.stream().anyMatch(f->f.getClassName().equals("REGISTRY_PACKAGE.RegisterEvent"));
    if(text.contains(" SUPPLIER ")&&!registering)throw new AssertionError("Not official RegisterEvent");
    if(text.contains(" CALLBACK ")&&(registering||!phase.equals("QUERY")))throw new AssertionError("Callback too early");
    if(text.contains(" HANDLER ")&&(!phase.equals("LOADING")||frames.stream().noneMatch(f->f.getClassName().equals("HOST.bus.EventBus")&&f.getMethodName().equals("post"))))throw new AssertionError("Not native EventBus post/lifecycle");
    for(var f:frames)original.println("[DF4C3] FRAME "+f.getClassName()+"."+f.getMethodName());
   }
  }});
  GLOBAL_BUS.addListener(EventPriority.LOWEST,this::started);
 }
 private String mod(){return variant.equals("combined")?"catalogbus":variant+"bus";}
 private Object owner(){return ModList.get().getModContainerById(mod()).orElseThrow();}
 private Class<?> source(String name)throws ReflectiveOperationException {var owner=ModList.get().getModContainerById(mod()).orElseThrow();var module=getClass().getModule().getLayer().findModule(owner.getModInfo().getOwningFile().moduleName()).orElseThrow();return Class.forName(module,"org.example."+variant+"bus."+name);}
 private Class<?> sourceUnchecked(){try{return source("EntryPoint");}catch(ReflectiveOperationException e){throw new AssertionError(e);}}
 private int count(String key){return calls.getOrDefault("[DF4C3] "+key,0);}
 private void early(){try{if(early)throw new AssertionError("Early repeated");early=true;source("Consumer").getMethod("first").invoke(null);throw new AssertionError("Early consume succeeded");}catch(java.lang.reflect.InvocationTargetException e){if(!(e.getCause() instanceof NullPointerException||e.getCause() instanceof IllegalStateException))throw new AssertionError(e);original.println("[DF4C3] EARLY REFUSED");}catch(ReflectiveOperationException e){throw new AssertionError(e);}}
 private void started(ServerStartedEvent event){try{
  if(queried)throw new AssertionError("Repeated server event");queried=true;
  int expected=variant.equals("quiet")?0:1;if(count("HANDLER "+variant)!=expected)throw new AssertionError("Incorrect handler count "+calls);
  Object container=owner();Object bus=container.getClass().getMethod("getEventBus").invoke(container);var listeners=GLOBAL_BUS.getClass().getDeclaredField("listeners");listeners.setAccessible(true);var table=(Map<?,?>)listeners.get(GLOBAL_BUS);var entries=table.keySet().stream().filter(k->k.getClass()==sourceUnchecked()).toList();if(entries.size()!=expected)throw new AssertionError("Native registered-object count "+entries.size());Object instance=entries.isEmpty()?null:entries.getFirst();
  if(bus==GLOBAL_BUS||instance!=null&&instance.getClass()!=source("EntryPoint"))throw new AssertionError("Wrong bus/object identity");
  original.println("[DF4C3] IDENTITIES global="+System.identityHashCode(GLOBAL_BUS)+" mod="+System.identityHashCode(bus)+" object="+System.identityHashCode(instance)+" nativeSourceObjects="+entries.size());
  if(variant.equals("combined")){
   boolean enabled=!"false".equals(System.getenv("DF4C3_REGISTER"));if(!early)throw new AssertionError("No early check");Object[] items=new Object[2];String[] ids={"shared","second"},fields={"FIRST","SECOND"};
   for(int i=0;i<2;i++){var id=ResourceLocation.fromNamespaceAndPath(mod(),ids[i]);if(BuiltInRegistries.ITEM.containsKey(id)!=enabled||count("SUPPLIER "+(i==0?"first":"second"))!=(enabled?1:0))throw new AssertionError("Item count/ID");if(enabled){items[i]=BuiltInRegistries.ITEM.getOptional(id).orElseThrow();Object h=source("Items").getField(fields[i]).get(null);if(h.getClass().getMethod("get").invoke(h)!=items[i]||!id.equals(BuiltInRegistries.ITEM.getKey((Item)items[i])))throw new AssertionError("Holder identity");}}
   var id=ResourceLocation.fromNamespaceAndPath(mod(),"shared");if(BuiltInRegistries.CREATIVE_MODE_TAB.containsKey(id)!=enabled||count("SUPPLIER tab")!=(enabled?1:0)||count("CALLBACK icon")!=0||count("CALLBACK display")!=0)throw new AssertionError("Tab/eager callback");
   if(enabled){var tab=BuiltInRegistries.CREATIVE_MODE_TAB.getOptional(id).orElseThrow();Object h=source("Shelves").getField("SHELF").get(null);if(h.getClass().getMethod("get").invoke(h)!=tab||source("Consumer").getMethod("tab").invoke(null)!=tab||source("Consumer").getMethod("tabReceipt").invoke(null)!=h||items[0]==items[1])throw new AssertionError("Tab consumer identity");phase="QUERY";if(tab.getIconItem().getItem()!=items[0]||tab.getIconItem().getItem()!=items[0]||count("CALLBACK icon")!=1)throw new AssertionError("Icon count");tab.buildContents(new CreativeModeTab.ItemDisplayParameters(FeatureFlags.DEFAULT_FLAGS,true,event.getServer().registryAccess()));if(!tab.getDisplayItems().stream().map(ItemStack::getItem).toList().equals(List.of(items[0],items[1]))||count("CALLBACK display")!=1)throw new AssertionError("Display count");}
   original.println("[DF4C3] REGISTRY PASS enabled="+enabled);
  }
  phase="DONE";original.println("[DF4C3] PASS variant="+variant+" handlers="+expected);System.setOut(original);
 }catch(ReflectiveOperationException e){throw new AssertionError(e);}}
}
