package @PACKAGE@;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.network.RegistryFriendlyByteBuf;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
public final class Down implements CustomPacketPayload {
    public static final Type<Down> TYPE=new Type<>(ResourceLocation.fromNamespaceAndPath("@ID@","down"));
    public static final StreamCodec<RegistryFriendlyByteBuf,Down> STREAM_CODEC=StreamCodec.of((buffer,data)->buffer.writeVarInt(data.number),buffer->new Down(buffer.readVarInt()));
    private final int number;
    public Down(int number){this.number=number;}
    public int number(){return number;}
    public Type<Down> type(){return TYPE;}
}
