package @PACKAGE@;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.network.RegistryFriendlyByteBuf;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
public final class Up implements CustomPacketPayload {
    public static final Type<Up> TYPE=new Type<>(ResourceLocation.fromNamespaceAndPath("@ID@","up"));
    public static final StreamCodec<RegistryFriendlyByteBuf,Up> STREAM_CODEC=StreamCodec.of((buffer,data)->buffer.writeVarInt(data.number),buffer->new Up(buffer.readVarInt()));
    private final int number;
    public Up(int number){this.number=number;}
    public int number(){return number;}
    public Type<Up> type(){return TYPE;}
}
