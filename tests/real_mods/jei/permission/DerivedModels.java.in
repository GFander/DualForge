    private List<Object> richValues(Class<?> packet)throws Exception{
        String pkg=packet.getPackageName();Module owner=packet.getModule();Class<?> mode=Class.forName(owner,pkg+".Mode"),record=Class.forName(owner,pkg+".TransferData");Object a=record.getConstructor(int.class,int.class).newInstance(0,127),b=record.getConstructor(int.class,int.class).newInstance(Integer.MAX_VALUE,Integer.MIN_VALUE);List<Object> values=new ArrayList<>();
        for(Object m:mode.getEnumConstants())for(List<?> ops:List.of(List.of(),List.of(a),List.of(a,b)))for(boolean flag:new boolean[]{false,true}){
            var stack=new net.minecraft.world.item.ItemStack(net.minecraft.world.item.Items.PAPER,7);stack.set(net.minecraft.core.component.DataComponents.CUSTOM_NAME,net.minecraft.network.chat.Component.literal("010G 汉字"));values.add(packet.getConstructor(net.minecraft.world.item.ItemStack.class,mode,List.class,String.class,boolean.class,int.class).newInstance(stack,m,ops,flag?"é 汉字":"",flag,flag?Integer.MAX_VALUE:Integer.MIN_VALUE));
        }return values;
    }
    private void checkRich(Object value,Object decoded)throws Exception{
        for(Field f:value.getClass().getDeclaredFields())if(!Modifier.isStatic(f.getModifiers())){f.setAccessible(true);Object a=f.get(value),b=f.get(decoded);if(a instanceof net.minecraft.world.item.ItemStack stack)check(b instanceof net.minecraft.world.item.ItemStack && net.minecraft.world.item.ItemStack.matches(stack,(net.minecraft.world.item.ItemStack)b),"actual ItemStack item/count/components");else check(Objects.equals(a,b),"rich enum/record list/UTF8/bool/int "+f.getName());}
    }
    private void hierarchy(Class<?> packet,Object instance)throws Exception{
        Class<?> base=packet.getSuperclass();check(Modifier.isAbstract(base.getModifiers()) && base.getSuperclass()==Object.class && Arrays.asList(base.getInterfaces()).contains(CustomPacketPayload.class),"actual source parent/native interface chain");check(packet.getMethod("type").getDeclaringClass()==packet && packet.getMethod("streamCodec").getDeclaringClass()==packet && packet.getMethod("streamCodec").invoke(instance)==packet.getField("STREAM_CODEC").get(null) && ((CustomPacketPayload)instance).type()==packet.getField("TYPE").get(null),"actual override and native Type identity");
        check(packet.getMethod("inheritedValue").getDeclaringClass()==base && (int)packet.getMethod("inheritedValue").invoke(instance)==17 && (int)get(instance,"parentValue")==17,"actual parent constructor state and inherited method resolution");check(base.getModule()==packet.getModule() && base.getClassLoader()==packet.getClassLoader(),"parent belongs to original module/loader");
        String id=packet.getPackageName().endsWith("gatealpha")?"gatealpha":"gatebeta";String resource=packet.getName().replace('.','/')+".class";try(var jar=new java.util.jar.JarFile(java.nio.file.Path.of("mods",id+".jar").toFile());var stream=packet.getModule().getResourceAsStream(resource)){check(stream!=null && Arrays.equals(jar.getInputStream(jar.getJarEntry(resource)).readAllBytes(),stream.readAllBytes()),"unmodified source class resource on actual module");}
    }
    @SuppressWarnings({"rawtypes","unchecked"})
    private void codecFailures(net.minecraft.server.MinecraftServer server,Object[] networks)throws Exception{
        for(Object network:networks){String pkg=network.getClass().getPackageName();Module owner=network.getClass().getModule();Class<?> packet=Class.forName(owner,pkg+".UpWords");var codec=(StreamCodec)packet.getField("STREAM_CODEC").get(null);var encoded=new RegistryFriendlyByteBuf(Unpooled.buffer(),server.registryAccess());var cut=new RegistryFriendlyByteBuf(Unpooled.buffer(),server.registryAccess());try{codec.encode(encoded,richValues(packet).getFirst());cut.writeBytes(encoded,encoded.readableBytes()-1);try{codec.decode(cut);throw new AssertionError("truncated rich packet decoded");}catch(IndexOutOfBoundsException expected){check(true,"truncated input preserves native failure");}}finally{encoded.release();cut.release();}
            Class<?> mode=Class.forName(owner,pkg+".Mode"),helper=Class.forName(owner,pkg+".EnumCodec");var enumCodec=(StreamCodec)helper.getConstructor(Class.class).newInstance(mode);var buffer=new RegistryFriendlyByteBuf(Unpooled.buffer(),server.registryAccess());try{buffer.writeVarInt(Integer.MAX_VALUE);try{enumCodec.decode(buffer);throw new AssertionError("unverified enum ordinal accepted");}catch(IndexOutOfBoundsException expected){check(true,"actual enum decoder range failure preserved");}try{enumCodec.encode(buffer,null);throw new AssertionError("null enum encoded");}catch(NullPointerException expected){check(true,"actual enum encoder null failure preserved");}}finally{buffer.release();}
            check(Arrays.stream(helper.getDeclaredMethods()).filter(Method::isBridge).count()==2,"both original synthetic enum bridges retained and used by codec");
        }System.out.println("DERIVED_CODEC_NEGATIVE_MODEL_PASS registry=ACTUAL_SERVER; malformed/truncated/ordinal/null; REAL_PACKET_DELIVERY=NOT_RUN");
    }
    private boolean configured(Object network)throws Exception{Object config=get(network,"config");return (boolean)config.getClass().getMethod("enabled").invoke(config);}
