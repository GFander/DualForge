    /** Ordinary unconnected Player test double, never a ServerPlayer or a network sender. */
    private static final class ModelPlayer extends net.minecraft.world.entity.player.Player {
        private final boolean creative,absent;private final int level;
        ModelPlayer(net.minecraft.server.MinecraftServer server,boolean creative,int level,boolean absent){super(server.overworld(),net.minecraft.core.BlockPos.ZERO,0.0f,new com.mojang.authlib.GameProfile(UUID.randomUUID(),"PermissionModel"));this.creative=creative;this.level=level;this.absent=absent;}
        public boolean isCreative(){return creative;}public boolean isSpectator(){return false;}
        protected int getPermissionLevel(){return level;}
        public net.minecraft.server.MinecraftServer getServer(){return absent?null:super.getServer();}
    }
    private static Throwable root(Throwable t){while(t.getCause()!=null)t=t.getCause();return t;}
    private boolean setting(Object cfg,String name)throws Exception{return (boolean)cfg.getClass().getMethod(name).invoke(cfg);}
    private void setSetting(Object cfg,String name,boolean value)throws Exception{Object supplier=get(cfg,name);supplier.getClass().getMethod("set",Object.class).invoke(supplier,value);check(setting(cfg,name)==value,"actual registered config supplier reads changed value");}
    private boolean allowed(Object network,net.minecraft.world.entity.player.Player player)throws Exception{
        Class<?> rules=Class.forName(network.getClass().getModule(),network.getClass().getPackageName()+".AccessRules");Class<?> api=Class.forName(network.getClass().getModule(),network.getClass().getPackageName()+".ISettings");
        return (boolean)rules.getMethod("allowed",net.minecraft.world.entity.player.Player.class,api).invoke(null,player,get(network,"config"));
    }
    private Object business(Object network,net.minecraft.world.entity.player.Player player)throws Exception{
        Class<?> context=Class.forName(network.getClass().getModule(),network.getClass().getPackageName()+".BusinessContext");
        return context.getConstructors()[0].newInstance(player,get(network,"config"),get(network,"server"),get(network,"client"));
    }
    private void process(Object network,Object ctx)throws Exception{
        Class<?> packet=Class.forName(network.getClass().getModule(),network.getClass().getPackageName()+".UpTuple");Object payload=packet.getConstructor(int.class,boolean.class).newInstance(127,true);packet.getMethod("process",ctx.getClass()).invoke(payload,ctx);
        check(get(ctx,"last")==payload && (int)get(ctx,"parentValue")==17 && get(ctx,"thread").equals(Thread.currentThread().getName()),"original safe packet/process/context data and server-thread record");
    }
    private Object originalConfig(Class<?> api,Object cfg){return Proxy.newProxyInstance(api.getClassLoader(),new Class<?>[]{api},(proxy,m,args)->switch(m.getName()){
        case "isCheatModeEnabledForCreative"->setting(cfg,"enabled");case "isCheatModeEnabledForOp"->setting(cfg,"secondary");case "isCheatModeEnabledForGive"->setting(cfg,"cancelDeath");case "toString"->"isolated original interface delegated to actual owning registered config";case "hashCode"->System.identityHashCode(proxy);case "equals"->proxy==args[0];default->throw new UnsupportedOperationException(m.toString());});}
