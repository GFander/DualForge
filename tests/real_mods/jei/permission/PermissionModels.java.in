                            else expected=(mask&4)!=0 && !absent && server.getCommands().getDispatcher().getRoot().getChild("give").canUse(stack);
                            boolean nativeOriginal=(boolean)source.invoke(null,player,originalCfg),independent=allowed(network,player);check(nativeOriginal==expected && independent==expected,"original and independent full ordered predicate/native permission on identical isolated model");
                            Object ctx=business(network,player);process(network,ctx);check((boolean)get(ctx,"enabled")==expected && (int)get(ctx,"count")==1 && (int)get(ctx,"protectedCalls")== (expected?1:0) && (int)get(ctx,"deniedCalls")== (expected?0:1),"permission false never executes protected counter; actual original safe branches");counts[expected?0:1]++;
