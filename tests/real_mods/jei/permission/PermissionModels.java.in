                        try{field.set(cfg,(java.util.function.Supplier<Boolean>)()->{throw sentinel;});ModelPlayer player=new ModelPlayer(server,false,0,false);Object ctx=business(network,player);for(java.util.concurrent.Callable<?> call:List.<java.util.concurrent.Callable<?>>of(()->source.invoke(null,player,originalCfg),()->allowed(network,player),()->{process(network,ctx);return null;})){try{call.call();throw new AssertionError("permission failure swallowed");}catch(Exception ex){check(root(ex)==sentinel,"original source exception identity retained");}}check((int)get(ctx,"protectedCalls")==0 && (int)get(ctx,"deniedCalls")==0 && (int)get(ctx,"count")==1,"exception grants nothing; prior local count is retained, no rollback");}finally{field.set(cfg,old);}
