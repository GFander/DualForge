                @DISCONNECTED@
            }
            Object a=get(networks[0],"config"),b=get(networks[1],"config");boolean[] saved={setting(a,"enabled"),setting(a,"secondary"),setting(a,"cancelDeath"),setting(b,"enabled"),setting(b,"secondary"),setting(b,"cancelDeath")};try{setSetting(a,"enabled",true);setSetting(a,"secondary",false);setSetting(a,"cancelDeath",false);setSetting(b,"enabled",false);setSetting(b,"secondary",false);setSetting(b,"cancelDeath",false);ModelPlayer player=new ModelPlayer(server,true,0,false);check(allowed(networks[0],player) && !allowed(networks[1],player),"same isolated player + distinct real ModContainer configs remain independent");}finally{int i=0;for(Object c:List.of(a,b))for(String n:List.of("enabled","secondary","cancelDeath"))setSetting(c,n,saved[i++]);}
            check(counts[0]>0 && counts[1]>0,"both source business branches actually executed");System.out.println("PERMISSION_COMPONENT_PASS cases="+(counts[0]+counts[1])+" allowed="+counts[0]+" denied="+counts[1]+" original=UNMODIFIED_JEI; scope=ISOLATED_ORDINARY_PLAYER_NATIVE_STACK_AND_ACTUAL_REGISTERED_CONFIG; REAL_SERVER_PLAYER=NOT_RUN REAL_CONNECTED_PLAYER=NOT_RUN REAL_PACKET_DELIVERY=NOT_RUN");
        }
        check(java.util.HexFormat.of().formatHex(java.security.MessageDigest.getInstance("SHA-256").digest(java.nio.file.Files.readAllBytes(original))).equals(digest),"original JEI component bytes unchanged");
