        try(var loader=new java.net.URLClassLoader(new java.net.URL[]{original.toUri().toURL()},getClass().getClassLoader())){
            Class<?> util=Class.forName("mezz.jei.common.util.ServerCommandUtil",true,loader),api=Class.forName("mezz.jei.common.config.IServerConfig",true,loader);Method source=util.getMethod("hasPermissionForCheatMode",net.minecraft.world.entity.player.Player.class,api);
            for(Object network:networks){
                Object cfg=get(network,"config");boolean[] saved={setting(cfg,"enabled"),setting(cfg,"secondary"),setting(cfg,"cancelDeath")};System.out.println("PERMISSION_REGISTERED_CONFIG owner="+network.getClass().getPackageName()+" creative="+saved[0]+" op="+saved[1]+" give="+saved[2]+" scope=REAL_FML_CONFIG");
                try{
                    Object originalCfg=originalConfig(api,cfg);
                    for(int mask=0;mask<8;mask++){
