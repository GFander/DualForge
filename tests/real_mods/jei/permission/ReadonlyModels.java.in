    private void readonlyPlan(Object container,Object network)throws Exception{
        Object session=((java.lang.ref.Reference<?>)((Map<?,?>)get(Class.forName("io.github.gfander.dualforge.ForgeDualBusBridge"),"STATES")).get(container)).get();Object plan=get(session,"plan");Method targets=plan.getClass().getDeclaredMethod("targets");targets.setAccessible(true);Set<?> set=(Set<?>)targets.invoke(plan),readOnly=(Set<?>)get(get(get(plan,"network"),"closure"),"readOnly");check(set.size()==8 && readOnly.size()==14,"eight rewrites/fourteen proved original dependencies");String id=network.getClass().getPackageName().endsWith("gatealpha")?"gatealpha":"gatebeta";
        try(var jar=new java.util.jar.JarFile(java.nio.file.Path.of("mods",id+".jar").toFile())){for(Object name:readOnly){String owner=(String)name;check(!set.contains(owner),"read-only dependency has no DualForge target");Class<?> clazz=Class.forName(network.getClass().getModule(),owner.replace('/','.'));check(clazz!=null && clazz.getModule()==network.getClass().getModule() && clazz.getClassLoader()==network.getClass().getClassLoader(),"actual read-only class module/loader");String member=owner+".class";try(var stream=clazz.getModule().getResourceAsStream(member)){check(stream!=null && Arrays.equals(jar.getInputStream(jar.getJarEntry(member)).readAllBytes(),stream.readAllBytes()),"every unclaimed source dependency resource keeps original bytes");}}}
        System.out.println("DERIVED_READONLY_DEPENDENCY_PASS owner="+id+" count=14 targets=8; ORIGINAL_MODULE_RESOURCES");
    }
