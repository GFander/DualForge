    private net.neoforged.neoforge.network.handling.IPayloadContext disconnectedContext(net.minecraft.server.MinecraftServer server)throws Exception{
        net.minecraft.network.Connection connection=new net.minecraft.network.Connection(PacketFlow.SERVERBOUND);
        Object listener=Proxy.newProxyInstance(net.minecraft.network.protocol.common.ServerCommonPacketListener.class.getClassLoader(),new Class<?>[]{net.minecraft.network.protocol.common.ServerCommonPacketListener.class},(self,m,args)->switch(m.getName()){
            case "getConnection"->connection;case "getMainThreadEventLoop"->server;case "protocol"->ConnectionProtocol.PLAY;case "flow"->PacketFlow.SERVERBOUND;case "toString"->"010G disconnected context component";case "hashCode"->System.identityHashCode(self);case "equals"->self==args[0];default->throw new UnsupportedOperationException(m.getName());});
        Field field=net.minecraft.network.Connection.class.getDeclaredField("packetListener");field.setAccessible(true);field.set(connection,listener);return new net.neoforged.neoforge.network.handling.ServerPayloadContext((net.minecraft.network.protocol.common.ServerCommonPacketListener)listener,net.minecraft.resources.ResourceLocation.fromNamespaceAndPath("permissionobserver","identity-model"));
    }
    private void identityModels(net.minecraft.server.MinecraftServer server,Object[] networks)throws Exception{
        Object session=get(networks[0],"channel"),identity=get(get(session,"owner"),"identity");Class<?> scope=Class.forName("io.github.gfander.dualforge.ForgeSourceContextBridge$Scope"),bridge=Class.forName("io.github.gfander.dualforge.ForgeSourceContextBridge");Constructor<?> constructor=scope.getDeclaredConstructors()[0];constructor.setAccessible(true);var nativeContext=disconnectedContext(server);
        Method verify=bridge.getDeclaredMethod("permissionIdentity",scope,Object.class,boolean.class);verify.setAccessible(true);
        Object wrong=constructor.newInstance(identity,nativeContext,networks[0],"uptuple",nativeContext.connection(),new Object(),true);rejected("WRONG_SERVER_AUTHORITY","WRONG_SERVER_AUTHORITY",()->verify.invoke(null,wrong,null,false));
        Object current=constructor.newInstance(identity,nativeContext,networks[0],"uptuple",nativeContext.connection(),server,true);rejected("WRONG_PLAYER_SOURCE","WRONG_PLAYER_SOURCE",()->verify.invoke(null,current,null,false));rejected("WRONG_PLAYER_OWNER_MODEL","WRONG_PLAYER_SOURCE",()->verify.invoke(null,current,new ModelPlayer(server,false,0,false),false));
        java.util.concurrent.atomic.AtomicReference<Throwable> result=new java.util.concurrent.atomic.AtomicReference<>();Thread thread=new Thread(()->{try{verify.invoke(null,current,null,true);}catch(Throwable ex){result.set(root(ex));}},"010G-isolated-wrong-thread");thread.start();thread.join();check(result.get()!=null && result.get().getMessage().contains("WRONG_PERMISSION_THREAD"),"permission queue rechecks native server thread before business");System.out.println("DERIVED_OWNER_NEGATIVE WRONG_PERMISSION_THREAD => "+result.get()+" scope=ISOLATED_GUARD_WITHOUT_SERVER_PLAYER");
        System.out.println("PERMISSION_IDENTITY_NEGATIVE_PASS scope=ISOLATED_LIVE_OWNER_AND_NATIVE_CONTEXT; VALID_CONNECTED_PLAYER_PATH=NOT_RUN");
    }
