package @PACKAGE@;
import io.netty.buffer.ByteBuf;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.network.codec.ByteBufCodecs;
public record TransferData(int source,int target) {
    public static final StreamCodec<ByteBuf,TransferData> STREAM_CODEC=StreamCodec.composite(ByteBufCodecs.VAR_INT,TransferData::source,ByteBufCodecs.VAR_INT,TransferData::target,TransferData::new);
}
