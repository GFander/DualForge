package @PACKAGE@;

import java.util.function.Consumer;
import net.minecraftforge.eventbus.api.Event;
import net.minecraftforge.eventbus.api.EventPriority;
import net.minecraftforge.eventbus.api.IEventBus;
import net.minecraftforge.fml.event.IModBusEvent;

public final class Subscriptions {
    private final IEventBus game;
    private final IEventBus mod;

    public Subscriptions(IEventBus game, IEventBus mod) {
        this.game = game;
        this.mod = mod;
    }

    public <T extends Event> void register(Class<T> event, Consumer<T> listener) {
        if (IModBusEvent.class.isAssignableFrom(event))
            mod.addListener(EventPriority.NORMAL, false, event, listener);
        else game.addListener(EventPriority.NORMAL, false, event, listener);
    }

    public <T extends Event> void registerCanceled(Class<T> event, Consumer<T> listener) {
        if (IModBusEvent.class.isAssignableFrom(event))
            mod.addListener(EventPriority.NORMAL, true, event, listener);
        else game.addListener(EventPriority.NORMAL, true, event, listener);
    }

    public <T extends Event> void unregister(Class<T> event, Consumer<T> listener) {
        if (IModBusEvent.class.isAssignableFrom(event)) mod.unregister(listener);
        else game.unregister(listener);
    }
}
