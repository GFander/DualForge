package @PACKAGE@;
import net.minecraft.server.level.ServerPlayer;
public final class BusinessContext {
    private final ServerPlayer sender;private final ISettings config;private final IServerConnection server;private final IClientConnection client;
    private int count;private Object last;private int parentValue;private boolean enabled;private String thread;
    public BusinessContext(ServerPlayer sender,ISettings config,IServerConnection server,IClientConnection client){this.sender=sender;this.config=config;this.server=server;this.client=client;}
    public void record(Object payload,int parent){count++;last=payload;parentValue=parent;enabled=config.enabled();thread=Thread.currentThread().getName();}
}
