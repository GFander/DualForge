import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
public final class DownTuple implements CustomPacketPayload {
    public static final Type<DownTuple> TYPE=new Type<>(ResourceLocation.fromNamespaceAndPath("@ID@","downtuple"));
    public static final StreamCodec<RegistryFriendlyByteBuf,DownTuple> STREAM_CODEC=StreamCodec.composite(ByteBufCodecs.VAR_INT,DownTuple::number,ByteBufCodecs.BOOL,DownTuple::flag,DownTuple::new);
    private final int number;private final boolean flag;
    public DownTuple(int number,boolean flag){this.number=number;this.flag=flag;}
