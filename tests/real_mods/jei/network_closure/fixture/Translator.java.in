package @PACKAGE@;
import java.util.Locale;
import java.util.function.Supplier;
public final class Translator {
    private static int registrations;
    private static Supplier<Locale> localeSupplier=()->Locale.ROOT;
    private Translator() { }
    public static void setLocaleSupplier(Supplier<Locale> supplier) { registrations++; localeSupplier=supplier; }
    public static String translateToLocal(String key) { return net.minecraft.client.resources.language.I18n.get(key); }
    public static String translateToLocalFormatted(String key,Object... args) { return net.minecraft.client.resources.language.I18n.get(key,args); }
    public static String toLowercaseWithLocale(String key) { Locale locale=localeSupplier.get();return key.toLowerCase(locale); }
}
