{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DualForge FnF gap analysis dataset v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataset",
    "inputSHA256",
    "scanSHA256",
    "atlasInputs",
    "runtime",
    "productionRulesEnabled",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataset": {
      "enum": [
        "class-inventory",
        "api-usage-matrix",
        "supplier-classification",
        "reference-closure",
        "compatibility-frontier",
        "next-task-dependencies"
      ]
    },
    "inputSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scanSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "atlasInputs": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "runtime": {
      "const": "NOT RUN"
    },
    "productionRulesEnabled": {
      "const": 0
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "class-inventory"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "classes",
              "classFileCount",
              "fields",
              "methods",
              "moduleIdentity"
            ],
            "properties": {
              "classes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "classSHA256",
                    "fields",
                    "methods",
                    "methodBodies",
                    "access",
                    "superclass",
                    "annotations"
                  ]
                }
              },
              "classFileCount": {
                "type": "integer",
                "minimum": 1
              },
              "fields": {
                "type": "integer",
                "minimum": 0
              },
              "methods": {
                "type": "integer",
                "minimum": 0
              },
              "moduleIdentity": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "api-usage-matrix"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "symbols",
              "externalUsePoints",
              "uniqueSymbols",
              "forgePointClassification",
              "unresolvedUsePoints"
            ],
            "properties": {
              "symbols": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "symbol",
                    "kind",
                    "owner",
                    "descriptor",
                    "classification",
                    "evidence",
                    "targetCandidate",
                    "usePoints"
                  ]
                }
              },
              "externalUsePoints": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueSymbols": {
                "type": "integer",
                "minimum": 0
              },
              "forgePointClassification": {
                "type": "object"
              },
              "unresolvedUsePoints": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "supplier-classification"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "sites",
              "totalInvokeDynamic",
              "classificationCounts",
              "unresolvedSites"
            ],
            "properties": {
              "sites": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "class",
                    "classSHA256",
                    "classification",
                    "implementation",
                    "bootstrap",
                    "bootstrapArguments",
                    "evidence",
                    "zeroCapture",
                    "safetyApproval"
                  ]
                }
              },
              "totalInvokeDynamic": {
                "type": "integer",
                "minimum": 0
              },
              "classificationCounts": {
                "type": "object"
              },
              "unresolvedSites": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "reference-closure"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "ownedClasses",
              "edges",
              "edgeCount",
              "limits"
            ],
            "properties": {
              "ownedClasses": {
                "type": "array",
                "uniqueItems": true
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "from",
                    "to",
                    "kind",
                    "method",
                    "index",
                    "context"
                  ]
                }
              },
              "edgeCount": {
                "type": "integer",
                "minimum": 0
              },
              "limits": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "compatibility-frontier"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "status",
              "boundaries",
              "fnfRuntime",
              "newProductionCapability"
            ],
            "properties": {
              "status": {
                "const": "STATIC_ANALYSIS_ONLY"
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "stage",
                    "result"
                  ]
                }
              },
              "fnfRuntime": {
                "const": "NOT RUN"
              },
              "newProductionCapability": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "next-task-dependencies"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "recommendedUniqueNextObjective",
              "tasks"
            ],
            "properties": {
              "recommendedUniqueNextObjective": {
                "type": "string"
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "phase",
                    "dependsOn",
                    "scope",
                    "acceptance"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
